{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "麦克风混音助手",
  "version": "0.1.0",
  "identifier": "dev.local.mixer",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "麦克风混音助手 · 把音频和人声一起传给对方",
        "width": 920,
        "height": 660,
        "minWidth": 660,
        "minHeight": 500,
        "resizable": true,
        "titleBarStyle": "Visible",
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "nsis"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md"
    },
    "shortDescription": "将本地音频与麦克风人声混合，让对方听到",
    "longDescription": "将本地音频与麦克风人声实时混合，通过虚拟音频设备传给语音、会议、直播或游戏中的对方。支持音效切换、单独调音量、循环播放、仅自己可听的试听和手机遥控。",
    "copyright": "Copyright (c) 2026 zhangguanghui <1003986591@qq.com>",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "麦克风混音助手",
        "compression": "lzma"
      }
    }
  }
}
