{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "音效板",
  "version": "0.1.0",
  "identifier": "dev.local.mixer",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "音效板 · 把音频播进麦克风",
        "width": 920,
        "height": 660,
        "minWidth": 660,
        "minHeight": 500,
        "resizable": true,
        "titleBarStyle": "Visible",
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "nsis"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "shortDescription": "把音频播进麦克风，让队友听到",
    "longDescription": "在游戏里按一个键，队友就听到你选的音频；同时你的真实说话声完全不受影响。",
    "copyright": "Copyright (c) 2026 zhangguanghui <1003986591@qq.com>",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "音效板",
        "compression": "lzma"
      }
    }
  }
}
